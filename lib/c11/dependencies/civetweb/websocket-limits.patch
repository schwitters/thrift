+    WEBSOCKET_SIZE_CLOSE = 1009,
+    WEBSOCKET_CLOSE_BYTES = 2,
+    WEBSOCKET_MILLISECONDS_PER_SECOND = 1000
+};
+
+/* Thrift C11 extension, revision 1. Configure only in the connect/ready callback.
+ * Both a finite frame bound and deadline are mandatory; masking is enforced.
+ * No allocation or I/O occurs here. */
+CIVETWEB_API int
+mg_set_websocket_limits(const struct mg_connection *connection, size_t max_frame_size,
+                        unsigned timeout_ms)
+{
+	struct mg_connection *conn = (struct mg_connection *)connection;
+	if (!conn || !max_frame_size || max_frame_size > INT_MAX || !timeout_ms
+	    || timeout_ms > INT_MAX) {
+		return 0;
+	}
+	conn->websocket_frame_limit = max_frame_size;
+	conn->websocket_frame_timeout_ms = timeout_ms;
+	return 1;
+}
+
+/* Use CivetWeb's portable monotonic clock, including its Windows backend.
+ * Failure expires the deadline rather than disabling protection. */
+static double
+websocket_frame_time(void)
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) {
+		return -1.0;
+	}
+	return (double)now.tv_sec + (double)now.tv_nsec / 1.0E9;
+}
+
+static int
+websocket_frame_remaining(double deadline, double *remaining)
+{
+	double now = websocket_frame_time();
+	if (now < 0.0 || now >= deadline) {
+		return 0;
+	}
+	*remaining = deadline - now;
+	return 1;
+}
