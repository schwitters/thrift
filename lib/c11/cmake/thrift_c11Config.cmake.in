@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(thrift_c11_TLS @THRIFT_C11_TLS@)
if(thrift_c11_TLS AND NOT WIN32)
    find_dependency(OpenSSL 1.1.1)
    find_dependency(Threads)
endif()
set(thrift_c11_ZSTD @THRIFT_C11_ZSTD@)
set(thrift_c11_HTTP_CLIENT @THRIFT_C11_HTTP_CLIENT@)
set(thrift_c11_HTTP_SERVER @THRIFT_C11_HTTP_SERVER@)
set(thrift_c11_WEBSOCKET_CLIENT @THRIFT_C11_WEBSOCKET_CLIENT@)
set(thrift_c11_WEBSOCKET_SERVER @THRIFT_C11_WEBSOCKET_SERVER@)
if(thrift_c11_ZSTD)
    find_dependency(zstd 1.4 CONFIG)
endif()
if(thrift_c11_WEBSOCKET_CLIENT)
    find_dependency(CURL 8.14)
elseif(thrift_c11_HTTP_CLIENT)
    find_dependency(CURL 7.85)
endif()
if(thrift_c11_HTTP_SERVER OR thrift_c11_WEBSOCKET_SERVER)
    find_dependency(civetweb CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/thrift_c11_targets.cmake")
check_required_components(thrift_c11)
