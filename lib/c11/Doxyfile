# Run from lib/c11: doxygen Doxyfile
PROJECT_NAME           = "Apache Thrift C11 runtime"
OUTPUT_DIRECTORY       = docs/api
INPUT                  = src/thrift/c11
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE_PATTERNS       = *_internal.h
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
SHOW_INCLUDE_FILES     = YES
FULL_PATH_NAMES        = NO
JAVADOC_AUTOBRIEF      = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
